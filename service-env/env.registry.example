# Minimal env for docker-compose.registry.yml (beginner registry deploy).
# Copy to .env and fill in the values marked REQUIRED.

# --- Images (Docker Hub) -------------------------------------------------
UV_REGISTRY=docker.io/styakush
# Prefer a released tag (e.g. v1.0.4). Release archives rewrite this to the
# packaged version. ":latest" is updated on each successful GitHub release.
UV_VERSION=latest

# --- REQUIRED secrets ----------------------------------------------------
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
AUTH_JWT_SECRET=

# First admin user created on empty database. Change before any shared host.
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=

# development = allows shorter bootstrap passwords for local try-outs.
# Set to production on any shared / internet-facing host.
APP_ENV=development

# --- Browser / scan policy -----------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Lab default: allow any target. Tighten before shared / internet-facing hosts.
SCAN_ALLOWED_CIDRS=0.0.0.0/0,::/0
SCAN_MAX_HOSTS=1024
SCAN_MAX_PORTS=65535

# --- Optional tuning -----------------------------------------------------
LOGGER_DEBUG=false
CVE_SYNC_ENABLED=true
CVE_MATCH_ENABLED=true
CVE_RISK_ENABLED=true
# Optional NVD API key speeds up CVE catalog sync:
# NVD_API_KEY=
