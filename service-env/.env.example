# Local dev: merge prod + dev compose so plain `docker compose up --build` builds from source
# instead of pulling from the registry. Release archives omit this line.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Image registry and release tag (tag for locally built images when using docker-compose.dev.yml).
UV_REGISTRY=docker.io/styakush
UV_VERSION=dev

# Local stack tuned for fast scans (high TCP concurrency, parallel probes, shorter probe timeout).
# Optional; if unset, uv-scanner searches ./geoip and /geoip for ip-to-country.mmdb + ip-to-asn.mmdb.
GEOIP_CITY_PATH=
GEOIP_ASN_PATH=

# uv-api listeners (required when running ./bin/uv-api outside compose).
SERVER_ADDR=0.0.0.0
SERVER_PORT=8080
METRICS_ADDR=0.0.0.0
METRICS_PORT=9090
REALTIME_ADDR=0.0.0.0
REALTIME_PORT=8081
# JWT roles allowed on WebSocket /v1/ws (comma-separated).
REALTIME_WS_ALLOWED_ROLES=viewer,operator,admin

# Browser origins allowed for REST (CORS) and WebSocket (OriginPatterns).
# WebSocket also allows path.Match globs for 127.*.*.* on dev ports 3000/4173/5173 (Vite
# on 0.0.0.0, preview, port-forwarded URLs like http://127.191.208.128:5173).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# SPA build-time URLs (docker-compose.dev.yml → service-frontend image).
# Release nginx serves the app with relative /api (REST → :8080) and /realtime (WS → :8081).
# Vite dev (npm run dev) uses /api and /realtime proxies instead of these absolute URLs.
VITE_API_URL=/api
VITE_REALTIME_URL=/realtime
# Base images for service-frontend build (docker-compose.dev.yml). Defaults use GHCR for nginx.
# If pulls still fail, override in .env:
# NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
# NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine
# uv-api/uv-scanner read this; postgres uses secrets/postgres_password (must match).
# make dev runs scripts/sync-dev-secrets.sh; install.sh syncs on production install.
POSTGRES_PASSWORD=
AUTH_JWT_SECRET=ultraviolet_local_jwt_secret_change_me
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=168h
# Bootstrap user: admin/admin is fine for local dev but MUST be changed before
# any non-local deployment. Pick a passphrase >= 12 characters for production.
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=admin
AUTH_BOOTSTRAP_ROLE=admin
# Per-IP rate limit on /v1/auth/login and /v1/auth/refresh. Tune up if the
# service sits behind a NAT that collapses many real users into one source IP.
AUTH_RATE_LIMIT_RPS=1
AUTH_RATE_LIMIT_BURST=5
# APP_ENV=production hardens bootstrap (rejects admin/admin and short
# passwords) and any other production-only fail-fast checks. Set to
# "development" only on developer machines.
APP_ENV=production
# Policy allowlist enforced on every scan: sequential targets must fall inside
# one of these CIDRs, and the random target_strategy samples its IPv4 pool
# exclusively from here (slow, masscan, and zmap engines all share this pool —
# IPv6 entries are ignored on the random path since masscan/zmap are IPv4-only).
SCAN_ALLOWED_CIDRS=0.0.0.0/0,::/0
SCAN_MAX_HOSTS=4096
SCAN_MAX_PORTS=65535
SCANNER_RUNNING_TTL=1h
SCANNER_WORKER_POLL_INTERVAL=1s
# Background runner: NVD mirror, CVE matcher, KEV/EPSS enrichment, retention,
# alert sweeps. Separate goroutine, slower cadence on purpose — keeps the hot
# queue.Claim path latency-bounded while a multi-minute NVD window is in
# flight.
SCANNER_BACKGROUND_POLL_INTERVAL=30s
SCANNER_PROGRESS_INTERVAL=1s
# uv-api pool (production compose default: 10). Dev override in docker-compose.dev.yml.
API_POSTGRES_MAX_CONNECTIONS=40
SCANNER_POSTGRES_MAX_CONNECTIONS=48
SCANNER_PROBE_WORKERS=48
PORTSCAN_WORKERS=512
PORTSCAN_TIMEOUT=2s
PORTSCAN_RATE_PER_SEC=5000
# Cap simultaneous TCP dials per destination IP. 64 keeps single-host scans
# parallel while avoiding stateful-firewall SYN drops that show up as false
# closed ports. Set to 0 to disable the per-IP cap.
PORTSCAN_MAX_DIALS_PER_IP=64
PROBE_TIMEOUT=5s
PROBE_MAX_BODY_BYTES=262144
# Probes: stdlib | native
PROBE_BACKEND=native
# PTR batch after scan — see service-api/internal/pkg/reversedns/config.go
RDNS_PTR_ENABLED=true
RDNS_GO_PROCESSES=4
RDNS_TIMEOUT=2m
# Forward DNS enrichment (A/AAAA/CNAME/MX/NS/TXT/SOA/CAA/SRV lookups). See
# service-api/internal/pkg/forwarddns/config.go. Off by default — flip on to
# populate uv_dns_record from PTR hostnames, TLS SANs, and (if CTLOGS_ENABLED)
# CT-log discoveries. Resolvers are queried round-robin with failover.
FDNS_ENABLED=true
FDNS_THREADS=4
FDNS_TIMEOUT=2m
FDNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53
FDNS_QUERY_TIMEOUT=3s
FDNS_RETRIES=1
# Masscan scan mode — only uv-scanner; see internal/pkg/masscan/config.go
MASSCAN_BINARY=masscan
MASSCAN_RATE=3000
# Extra SYN sends per port. Compensates packet loss on intermediate hops
# (stateful firewalls, NAT, congested links) so a high MASSCAN_RATE doesn't
# silently degrade detection quality. 0 disables retries.
MASSCAN_RETRIES=2
MASSCAN_WAIT_SECONDS=30
MASSCAN_INTERFACE=
MASSCAN_UNPRIVILEGED=false
# Zmap scan mode — only uv-scanner; see internal/pkg/zmap/config.go
ZMAP_BINARY=zmap
ZMAP_RATE=1000
ZMAP_COOLDOWN_SECONDS=8
ZMAP_INTERFACE=
# UDP probe ports run after each TCP pass (set to "" to disable). Includes
# 53 (DNS), 161 (SNMP), 123 (NTP), 5353 (mDNS), 623 (IPMI).
SCANNER_UDP_PROBE_PORTS=53,161,123,5353,623
# JARM TLS fingerprinting (on by default).
PROBE_JARM_ENABLED=true
# Retention windows (the cleanup worker enforces these every RETENTION_TICK_EVERY).
RETENTION_SNAPSHOTS=720h
RETENTION_ALERT_EVENTS=720h
RETENTION_CHANGE_EVENTS=2160h
RETENTION_HTTP_BODY=720h
RETENTION_HTTP_SCREENSHOTS=720h
RETENTION_TICK_EVERY=6h
# HTTP screenshot capture (uv-scanner background worker -> chromium service ->
# uv_http_screenshot). On by default; set false to disable the worker.
HTTP_SCREENSHOT_ENABLED=true
HTTP_SCREENSHOT_CHROMIUM_URL=http://chromium:9222
HTTP_SCREENSHOT_TIMEOUT=15s
HTTP_SCREENSHOT_NAVIGATE_TIMEOUT=10s
HTTP_SCREENSHOT_MAX_CONCURRENT=4
HTTP_SCREENSHOT_VIEWPORT_WIDTH=1280
HTTP_SCREENSHOT_VIEWPORT_HEIGHT=800
HTTP_SCREENSHOT_THUMBNAIL_WIDTH=640
HTTP_SCREENSHOT_JPEG_QUALITY=80
SCREENSHOT_WORKER_BATCH=8
CHROMIUM_MEMORY_LIMIT=1g
# NVD CVE 2.0 mirror — provides Known CVEs on hosts/services.
# A free API key from https://nvd.nist.gov/developers/request-an-api-key raises
# the rate limit from 5 to 50 req/30s, which speeds up the initial bootstrap.
NVD_BASE_URL=https://services.nvd.nist.gov
NVD_API_KEY=
NVD_PAGE_SIZE=2000
NVD_TIMEOUT=30s
NVD_USER_AGENT=UltraViolet/0.1
NVD_MAX_RETRIES=5
NVD_MIN_INTERVAL=0s
CVE_SYNC_ENABLED=true
CVE_SYNC_INTERVAL=6h
CVE_SYNC_BOOTSTRAP_FROM=262800h
# Persist NVD raw JSON inside uv_cve.raw_json. Off shrinks the catalog ~5x.
CVE_SYNC_STORE_RAW_JSON=true
CVE_MATCH_ENABLED=true
CVE_MATCH_INTERVAL=15m
CVE_MATCH_BATCH=500
CVE_MATCH_CONCURRENCY=8
# Minimum confidence threshold (0–100). 40 suppresses versionless and backport-penalised findings.
CVE_MATCH_MIN_CONFIDENCE=0
# Periodic CISA KEV + FIRST EPSS enrichment of the local catalog.
CVE_RISK_ENABLED=true
CVE_RISK_INTERVAL=24h
CVE_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
CVE_EPSS_URL=https://epss.cyentia.com/epss_scores-current.csv.gz
CVE_RISK_TIMEOUT=60s
CVE_RISK_USER_AGENT=UltraViolet/0.1
# Optional CVE catalog seed (pg_dump -Fc, data-only uv_cve + uv_cve_cpe).
# Precedence: CVE_CATALOG_SEED_FILE, then newest *.dump in CVE_CATALOG_SEED_DIR,
# then file /ServiceAPI/seed/cve-catalog.dump if it exists (Docker bind-mount).
# Restore runs once after migrations when uv_cve is empty. Schema must match migrations.
# Dump: from service-env run `make cve-catalog-dump` (Docker; writes
# ../service-api/deploy/seed/cve-catalog.dump).
CVE_CATALOG_SEED_FILE=
CVE_CATALOG_SEED_DIR=
# RTSP single-frame snapshot (uv-api POST /v1/hosts/{ip}/rtsp-snapshot). Needs
# ffmpeg on the API host or in the image. When false, the endpoint returns 503.
RTSP_SNAPSHOT_ENABLED=true
RTSP_SNAPSHOT_FFMPEG=ffmpeg
RTSP_SNAPSHOT_TIMEOUT=12s
RTSP_SNAPSHOT_MAX_CONCURRENT=4
# ONVIF Device + Media Service SOAP presets (uv-api POST /v1/hosts/{ip}/onvif-command).
# HTTP Basic, HTTP Digest (401 WWW-Authenticate), and WS-Security UsernameToken are supported.
# Optional response_shape=json (or legacy parse=true) returns structured fields alongside the raw SOAP body.
# When false, the endpoint returns 503.
ONVIF_COMMAND_ENABLED=true
ONVIF_COMMAND_TIMEOUT=15s
ONVIF_COMMAND_MAX_CONCURRENT=8
# Per-process token-bucket limiter (429 onvif_rate_limited when exceeded). Set RPS to 0 to disable.
ONVIF_COMMAND_RATE_LIMIT_RPS=5
ONVIF_COMMAND_RATE_LIMIT_BURST=20
# In-memory TTL cache for safe read-only device commands when password is empty (0 = disabled).
# Truncated SOAP bodies are never stored.
ONVIF_RESPONSE_CACHE_TTL=0s
# ONVIF-assisted RTSP snapshot (POST /v1/hosts/{ip}/onvif-rtsp-snapshot). When false, returns 503.
ONVIF_RTSP_SNAPSHOT_ENABLED=true
# Lab-only: sequential probe of a small built-in default password list via GetSystemDateAndTime (HTTP Basic).
# Enable only in trusted lab environments. Requires ONVIF_COMMAND_ENABLED (same gate as onvif-command). When false, returns 503 onvif_lab_probe_disabled.
ONVIF_LAB_CREDENTIAL_PROBE_ENABLED=true
# Optional path to a credentials file (one user:password per line, # comments). Empty = use built-in embedded list (see deploy/onvif-lab-credentials.example.txt).
ONVIF_LAB_CREDENTIALS_FILE=
# Max pairs loaded from file or embedded list (clamped 1–500).
ONVIF_LAB_CREDENTIAL_MAX_PAIRS=200
# HTTP client timeout per credential attempt.
ONVIF_LAB_PER_ATTEMPT_TIMEOUT=6s
# Pause between attempts (reduces burst load on the device).
ONVIF_LAB_INTER_ATTEMPT_DELAY=100ms
# CT log / WHOIS enrichment (off by default; opt in to enable network calls).
# When CTLOGS_ENABLED=true and FDNS_ENABLED=true, the scanner walks crt.sh
# for each apex domain found via PTR/SAN and feeds discovered subdomains
# back into forward DNS. The ASM worker (Attack Surface Discovery) also
# uses crt.sh, forward DNS, GeoIP ASN, and RIPE Stat — see ASM_* below.
CTLOGS_ENABLED=true
CTLOGS_BASE_URL=https://crt.sh
CTLOGS_TIMEOUT=15s
CTLOGS_LIMIT=50
CTLOGS_ASM_LIMIT=0
CTLOGS_USER_AGENT=UltraViolet/0.1
CTLOGS_MAX_RETRIES=5
RDAP_ENABLED=false
# Attack Surface Discovery (POST /v1/asm/discoveries). Background worker in
# uv-scanner: CT logs → DNS → GeoIP ASN → RIPE Stat BGP prefixes.
ASM_ENABLED=true
ASM_INTERVAL=5s
ASM_RUNNING_TTL=1h
# Attack-surface risk scoring (probability x impact model). The k coefficient
# and decay half-lives are seeded into uv_risk_policy on migration and can be
# tuned via the policies API; these env vars only control the in-process cache
# and the snapshot/event workers.
RISK_POLICY_CACHE_TTL=60s
RISK_SNAPSHOT_ENABLED=true
RISK_SNAPSHOT_INTERVAL=1h
RISK_SNAPSHOT_MIN_DELTA=2
RISK_EVENT_RETENTION_DAYS=180

# Risk-event LISTEN/NOTIFY worker (uv_risk_event channel). Consumes bucket-
# change / KEV-added / EPSS-spike events, evaluates active uv_risk_alert_rule
# matches and marks them fired. Polling fallback for dropped LISTEN connections.
RISK_EVENTS_ENABLED=true
RISK_EVENTS_POLL_INTERVAL=5s
RISK_EVENTS_BATCH_LIMIT=200

# In-process debounced recompute queue. CVE-matcher / ingest hooks enqueue
# host IDs; repeated requests inside the debounce window coalesce into one
# AggregateForHost call drained by a worker pool. Disable to fall back to the
# legacy synchronous hot-path.
RISK_RECOMPUTE_QUEUE_ENABLED=true
RISK_RECOMPUTE_DEBOUNCE=2s
RISK_RECOMPUTE_WORKERS=4

# Attack-path graph worker (rebuilds uv_host_relation + uv_host_attack_path_score
# from shared subnet/ASN/cert/favicon). INCREMENTAL keeps subsequent ticks
# cheap by only re-evaluating host pairs touched since the previous tick.
# MAX_NODES caps the host count past which the worker skips the pass;
# RELATION_MIN_STRENGTH drops edges weaker than the cutoff before persistence;
# CRITICAL_SCORE_CUTOFF flags critical neighbours for the pivot-score boost.
ATTACKPATH_ENABLED=true
ATTACKPATH_INTERVAL=6h
ATTACKPATH_INCREMENTAL=true
ATTACKPATH_MAX_NODES=50000
ATTACKPATH_RELATION_MIN_STRENGTH=0.10
ATTACKPATH_CRITICAL_SCORE_CUTOFF=75

# RIPE Stat announced-prefixes lookup (requires GEOIP_ASN_PATH for ASN grouping).
RIPESTAT_ENABLED=true
RIPESTAT_BASE_URL=https://stat.ripe.net
RIPESTAT_TIMEOUT=20s
RIPESTAT_USER_AGENT=UltraViolet/0.1
RIPESTAT_MAX_RETRIES=3
RIPESTAT_MIN_INTERVAL=1100ms
# OIDC SSO (off by default).
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_SCOPE="openid email profile"
# Backup sidecar (only when `--profile backup` is enabled).
BACKUP_INTERVAL_SECONDS=21600
# Grafana admin password (only when `--profile observability` is enabled).
GRAFANA_ADMIN_PASSWORD=admin
# Memory limits for the observability stack (only when `--profile observability` is enabled).
PROMETHEUS_MEMORY_LIMIT=2g
GRAFANA_MEMORY_LIMIT=1g
# Documentation site (only when `--profile docs` is enabled). Host port for the static UltraViolet docs.
UV_DOCUMENTATION_PORT=3002
